  m_Script: {fileID: 11500000, guid: d201ef38c6229cd4197b4413f9ca5e5c, type: 3}
  m_Name: VentIntro
  m_EditorClassIdentifier: Assembly-CSharp::PlayerDialogue
  priority: 1
  lines:
  - text: Perfect.
    voiceline: {fileID: 0}
  - text: "I\u2019ll have to watch out for solar flares."
    voiceline: {fileID: 0}
  - text: "They\u2019ll rapidly change the external temperatures\u2026 "
    voiceline: {fileID: 0}
  - text: "And I\u2019ll need to calibrate the heater again. "
    voiceline: {fileID: 0}
  - text: 'Before I forget, I should open the vents too. '
    voiceline: {fileID: 0}
  - text: 'Toxic fumes are making my eyes tear.  '
    voiceline: {fileID: 0}
